# Personal SCSB login. Leave blank to log in in the opened browser.
SCSB_ID=
SCSB_USER_CODE=
SCSB_PASSWORD=

# OpenRouter reads only the image CAPTCHA.
OPENROUTER_API_KEY=
OPENROUTER_CAPTCHA_MODEL=openai/gpt-6-luna
OPENROUTER_CATEGORY_MODEL=openai/gpt-6-luna

# Jev chooses among read-only controls when Playwright navigation needs help.
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest

SCSB_OUTPUT_DIR=./statements
SCSB_HEADLESS=false
SCSB_BROWSER_CHANNEL=chrome

# Set these after checking which SCSB TWD account matches an existing Ledgerly account.
LEDGERLY_EXISTING_TWD_INDEX=
LEDGERLY_EXISTING_TWD_SUFFIX=
LEDGERLY_EXISTING_TWD_ACCOUNT_ID=
