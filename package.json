{
  "name": "@ledgerly/scsb-ebank-automation",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun run src/index.ts",
    "import:existing": "bun run src/import-existing.ts",
    "categorize:existing": "bun run src/categorize-existing.ts",
    "check:unattended": "bun run src/check-config.ts",
